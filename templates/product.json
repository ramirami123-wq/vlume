        "custom_liquid_wbDEGx": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .bundle-selector {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin: 16px 0;\n    font-family: inherit;\n  }\n  .bundle-option {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 12px 16px;\n    border: 2px solid #e0e0e0;\n    border-radius: 12px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n    background: #fff;\n  }\n  .bundle-option:hover { border-color: #000; }\n  .bundle-option.selected {\n    border-color: #000;\n    background: #f9f9f9;\n  }\n  .bundle-option .bundle-left {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .bundle-radio {\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    border: 2px solid #ccc;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .bundle-option.selected .bundle-radio {\n    border-color: #000;\n    background: #000;\n  }\n  .bundle-option.selected .bundle-radio::after {\n    content: '';\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: #fff;\n    display: block;\n  }\n  .bundle-title {\n    font-weight: 600;\n    font-size: 14px;\n    color: #111;\n  }\n  .bundle-subtitle {\n    font-size: 12px;\n    color: #666;\n    margin-top: 2px;\n  }\n  .bundle-price {\n    font-weight: 700;\n    font-size: 15px;\n    color: #111;\n    text-align: right;\n  }\n  .bundle-badge {\n    background: #111;\n    color: #fff;\n    font-size: 11px;\n    font-weight: 600;\n    padding: 2px 8px;\n    border-radius: 20px;\n    margin-top: 4px;\n    display: inline-block;\n  }\n</style>\n\n<!-- Bundle Selector -->\n<div class=\"bundle-selector\">\n  <div class=\"bundle-option\" data-qty=\"1\" onclick=\"selectBundle(this, 1)\">\n    <div class=\"bundle-left\">\n      <div class=\"bundle-radio\"></div>\n      <div>\n        <div class=\"bundle-title\">Buy 1</div>\n        <div class=\"bundle-subtitle\">Standard order</div>\n      </div>\n    </div>\n    <div class=\"bundle-price\">$16</div>\n  </div>\n\n  <div class=\"bundle-option\" data-qty=\"2\" onclick=\"selectBundle(this, 2)\">\n    <div class=\"bundle-left\">\n      <div class=\"bundle-radio\"></div>\n      <div>\n        <div class=\"bundle-title\">Buy 2</div>\n        <div class=\"bundle-subtitle\">🚚 Free Delivery included!</div>\n      </div>\n    </div>\n    <div class=\"bundle-price\">$32</div>\n  </div>\n\n  <div class=\"bundle-option selected\" data-qty=\"3\" onclick=\"selectBundle(this, 3)\">\n    <div class=\"bundle-left\">\n      <div class=\"bundle-radio\"></div>\n      <div>\n        <div class=\"bundle-title\">Buy 3 ⭐ Best Value</div>\n        <div class=\"bundle-subtitle\">Save $5 automatically!</div>\n      </div>\n    </div>\n    <div style=\"text-align:right;\">\n      <div class=\"bundle-price\">$43</div>\n      <span class=\"bundle-badge\">Save $5</span>\n    </div>\n  </div>\n</div>\n\n<!-- Delivery Date Estimator -->\n<div style=\"padding: 12px; text-align: left; background-color: #f5f5f5; font-size: 15px; border-radius: 13px; margin-top: 12px; margin-bottom: 12px; display: flex; align-items: center;\">\n  <span class=\"em\" style=\"margin-right: 8px;\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\" viewBox=\"0 -960 960 960\" width=\"24px\" fill=\"#545454\">\n      <path d=\"M240-160q-50 0-85-35t-35-85H40v-440q0-33 23.5-56.5T120-800h560v160h120l120 160v200h-80q0 50-35 85t-85 35q-50 0-85-35t-35-85H360q0 50-35 85t-85 35Zm0-80q17 0 28.5-11.5T280-280q0-17-11.5-28.5T240-320q-17 0-28.5 11.5T200-280q0 17 11.5 28.5T240-240ZM120-360h32q17-18 39-29t49-11q27 0 49 11t39 29h272v-360H120v360Zm600 120q17 0 28.5-11.5T760-280q0-17-11.5-28.5T720-320q-17 0-28.5 11.5T680-280q0 17 11.5 28.5T720-240Zm-40-200h170l-90-120h-80v120ZM360-540Z\"/>\n    </svg>\n  </span>\n  <span>Order now to receive by <span id=\"delivery-dates\" style=\"font-weight: bold;\"></span></span>\n</div>\n\n<script>\n  // Bundle Selector\n  function selectBundle(el, qty) {\n    document.querySelectorAll('.bundle-option').forEach(function(opt) {\n      opt.classList.remove('selected');\n    });\n    el.classList.add('selected');\n    var qtyInput = document.querySelector('input[name=\"quantity\"], input.quantity__input, input[id*=\"quantity\"]');\n    if (qtyInput) {\n      qtyInput.value = qty;\n      qtyInput.dispatchEvent(new Event('change', { bubbles: true }));\n    }\n  }\n\n  document.addEventListener('DOMContentLoaded', function() {\n    // Auto-select Buy 3 on load\n    var defaultOption = document.querySelector('.bundle-option[data-qty=\"3\"]');\n    if (defaultOption) selectBundle(defaultOption, 3);\n\n    // Delivery Date Estimator (skips Sundays)\n    function addBusinessDays(date, days) {\n      var result = new Date(date);\n      var added = 0;\n      while (added < days) {\n        result.setDate(result.getDate() + 1);\n        if (result.getDay() !== 0) { added++; }\n      }\n      return result;\n    }\n\n    var currentDate = new Date();\n    var minDeliveryDate = addBusinessDays(currentDate, 3);\n    var maxDeliveryDate = addBusinessDays(currentDate, 5);\n\n    var formatDate = function(date) {\n      var dayNames = [\"Sunday\",\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\"];\n      var monthNames = [\"January\",\"February\",\"March\",\"April\",\"May\",\"June\",\"July\",\"August\",\"September\",\"October\",\"November\",\"December\"];\n      return dayNames[date.getDay()] + \", \" + monthNames[date.getMonth()] + \" \" + date.getDate();\n    };\n\n    document.getElementById('delivery-dates').textContent =\n      formatDate(minDeliveryDate) + ' – ' + formatDate(maxDeliveryDate);\n  });\n</script>"
          }
        },
