{% doc %}
  @prompt
    Create a new homepage image slideshow block that uses the same headings, text, buttons, and overall messaging as the existing image slides in the current homepage slideshow. Let the merchant add many image options as individual slides, while keeping that same text content across the slides. Make the slides advance automatically, with optional previous/next controls and indicators, and ensure it works well on mobile and desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-home-slideshow-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-home-slideshow-{{ ai_gen_id }}__viewport{position:relative;min-height:{{ block.settings.slide_height }}px}.ai-home-slideshow-{{ ai_gen_id }}__slide{position:absolute;inset:0;visibility:hidden;opacity:0;display:flex;align-items:{{ block.settings.content_position }};justify-content:{{ block.settings.content_alignment }};min-height:{{ block.settings.slide_height }}px;transition:opacity .35s ease,visibility .35s ease}.ai-home-slideshow-{{ ai_gen_id }}__slide.is-active{position:relative;visibility:visible;opacity:1}.ai-home-slideshow-{{ ai_gen_id }}__image,.ai-home-slideshow-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ai-home-slideshow-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;flex-direction:column;background:#f3f3f3;color:#5c5c5c}.ai-home-slideshow-{{ ai_gen_id }}__placeholder svg{width:42%;height:42%}.ai-home-slideshow-{{ ai_gen_id }}__shade{position:absolute;inset:0;background:rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }})}.ai-home-slideshow-{{ ai_gen_id }}__content{position:relative;z-index:1;width:min(620px,90%);padding:48px 32px;text-align:{{ block.settings.text_alignment }}}.ai-home-slideshow-{{ ai_gen_id }}__heading{margin:0 0 14px;color:{{ block.settings.text_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.1}.ai-home-slideshow-{{ ai_gen_id }}__text{margin:0 0 24px;color:{{ block.settings.text_color }};font-size:{{ block.settings.body_size }}px;line-height:1.5}.ai-home-slideshow-{{ ai_gen_id }}__actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:{% if block.settings.text_alignment == 'center' %}center{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %}}.ai-home-slideshow-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 22px;border:{{ block.settings.button_border_width }}px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};text-decoration:none;font-weight:600}.ai-home-slideshow-{{ ai_gen_id }}__controls{position:absolute;inset:50% 18px auto;z-index:2;display:flex;justify-content:space-between;transform:translateY(-50%);pointer-events:none}.ai-home-slideshow-{{ ai_gen_id }}__control{pointer-events:auto;width:42px;height:42px;border:0;border-radius:50%;background:{{ block.settings.control_color }};color:{{ block.settings.control_text_color }};cursor:pointer;font-size:24px}.ai-home-slideshow-{{ ai_gen_id }}__indicators{position:absolute;z-index:2;bottom:18px;left:50%;display:flex;gap:8px;transform:translateX(-50%)}.ai-home-slideshow-{{ ai_gen_id }}__indicator{width:10px;height:10px;padding:0;border:1px solid {{ block.settings.control_color }};border-radius:50%;background:transparent;cursor:pointer}.ai-home-slideshow-{{ ai_gen_id }}__indicator.is-active{background:{{ block.settings.control_color }}}.ai-home-slideshow-{{ ai_gen_id }}__button:focus-visible,.ai-home-slideshow-{{ ai_gen_id }}__control:focus-visible,.ai-home-slideshow-{{ ai_gen_id }}__indicator:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}@media(max-width:749px){.ai-home-slideshow-{{ ai_gen_id }}__viewport,.ai-home-slideshow-{{ ai_gen_id }}__slide{min-height:{{ block.settings.mobile_height }}px}.ai-home-slideshow-{{ ai_gen_id }}__content{padding:36px 22px}.ai-home-slideshow-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times:0.8 }}px}.ai-home-slideshow-{{ ai_gen_id }}__controls{inset-inline:10px}}{% endstyle %}
<image-slideshow-{{ ai_gen_id }} class="ai-home-slideshow-{{ ai_gen_id }}" data-autoplay="{{ block.settings.autoplay }}" data-interval="{{ block.settings.interval | times:1000 }}" {{ block.shopify_attributes }}><div class="ai-home-slideshow-{{ ai_gen_id }}__viewport">{% for i in (1..6) %}{% assign image_key='image_' | append:i %}{% assign image=block.settings[image_key] %}{% if image != blank %}<article class="ai-home-slideshow-{{ ai_gen_id }}__slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"><img class="ai-home-slideshow-{{ ai_gen_id }}__image" src="{{ image | image_url:width:2400 }}" alt="{{ image.alt | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}"><div class="ai-home-slideshow-{{ ai_gen_id }}__shade"></div><div class="ai-home-slideshow-{{ ai_gen_id }}__content">{% if block.settings.heading != blank %}<h2 class="ai-home-slideshow-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.text != blank %}<div class="ai-home-slideshow-{{ ai_gen_id }}__text">{{ block.settings.text }}</div>{% endif %}<div class="ai-home-slideshow-{{ ai_gen_id }}__actions">{% if block.settings.primary_label != blank and block.settings.primary_link != blank %}<a class="ai-home-slideshow-{{ ai_gen_id }}__button" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a>{% endif %}{% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}<a class="ai-home-slideshow-{{ ai_gen_id }}__button" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{% endif %}</div></div></article>{% elsif forloop.first %}<article class="ai-home-slideshow-{{ ai_gen_id }}__slide is-active"><div class="ai-home-slideshow-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span>Add your first slide image</span></div></article>{% endif %}{% endfor %}{% if block.settings.show_controls %}<div class="ai-home-slideshow-{{ ai_gen_id }}__controls"><button class="ai-home-slideshow-{{ ai_gen_id }}__control" type="button" data-direction="previous" aria-label="Previous slide">‹</button><button class="ai-home-slideshow-{{ ai_gen_id }}__control" type="button" data-direction="next" aria-label="Next slide">›</button></div>{% endif %}{% if block.settings.show_indicators %}<div class="ai-home-slideshow-{{ ai_gen_id }}__indicators" role="tablist" aria-label="Slideshow navigation">{% for i in (1..6) %}{% assign image_key='image_' | append:i %}{% if block.settings[image_key] != blank %}<button class="ai-home-slideshow-{{ ai_gen_id }}__indicator{% if forloop.first %} is-active{% endif %}" type="button" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ i }}"></button>{% endif %}{% endfor %}</div>{% endif %}</div></image-slideshow-{{ ai_gen_id }}>
<script>(function(){class ImageSlideshow{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.slides=[...this.querySelectorAll('[data-slide-index]')];this.indicators=[...this.querySelectorAll('[data-index]')];this.current=0;this.querySelectorAll('[data-direction]').forEach(b=>b.addEventListener('click',()=>this.go(this.current+(b.dataset.direction==='next'?1:-1))));this.indicators.forEach(b=>b.addEventListener('click',()=>this.go(Number(b.dataset.index))));if(this.dataset.autoplay==='true'&&this.slides.length>1)this.timer=setInterval(()=>this.go(this.current+1),Number(this.dataset.interval))}go(i){if(!this.slides.length)return;this.current=(i+this.slides.length)%this.slides.length;this.slides.forEach((s,n)=>{s.classList.toggle('is-active',n===this.current);s.setAttribute('aria-hidden',n!==this.current)});this.indicators.forEach((b,n)=>b.classList.toggle('is-active',n===this.current))}}customElements.define('image-slideshow-{{ ai_gen_id }}',ImageSlideshow{{ ai_gen_id }});})();</script>
{% schema %}{"name":"Homepage image slideshow","settings":[{"type":"header","content":"Shared content"},{"type":"text","id":"heading","label":"Heading","default":"Discover your next favorite"},{"type":"richtext","id":"text","label":"Text","default":"<p>Explore our collection and find something made for your everyday moments.</p>"},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop now"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Learn more"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"header","content":"Slide images"},{"type":"image_picker","id":"image_1","label":"Slide image 1"},{"type":"image_picker","id":"image_2","label":"Slide image 2"},{"type":"image_picker","id":"image_3","label":"Slide image 3"},{"type":"image_picker","id":"image_4","label":"Slide image 4"},{"type":"image_picker","id":"image_5","label":"Slide image 5"},{"type":"image_picker","id":"image_6","label":"Slide image 6"},{"type":"header","content":"Slideshow settings"},{"type":"checkbox","id":"autoplay","label":"Advance automatically","default":true},{"type":"range","id":"interval","label":"Seconds between slides","min":3,"max":15,"step":1,"unit":"s","default":6},{"type":"checkbox","id":"show_controls","label":"Show previous and next","default":true},{"type":"checkbox","id":"show_indicators","label":"Show indicators","default":true},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"slide_height","label":"Desktop height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"mobile_height","label":"Mobile height","min":300,"max":700,"step":50,"unit":"px","default":500},{"type":"select","id":"content_position","label":"Content vertical position","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"select","id":"content_alignment","label":"Content horizontal position","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"range","id":"overlay_opacity","label":"Image overlay","min":0,"max":80,"step":5,"unit":"%","default":35},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"body_size","label":"Text size","min":14,"max":24,"step":2,"unit":"px","default":18},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"button_color","label":"Button","default":"#212326"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"control_color","label":"Controls","default":"#ffffff"},{"type":"color","id":"control_text_color","label":"Control icons","default":"#212326"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#87adf5"},{"type":"range","id":"button_border_width","label":"Button border","min":0,"max":4,"step":1,"unit":"px","default":1},{"type":"range","id":"button_radius","label":"Button corners","min":0,"max":20,"step":2,"unit":"px","default":10}],"presets":[{"name":"Homepage image slideshow"}],"tag":null,"class":"homepage-image-slideshow"}{% endschema %}