{% doc %}
  @prompt
    Create a second, clearly different visual version of the featured-product media showcase for the homepage. Keep the same structure and current product media: a large product image, three editable benefit cards, thumbnails underneath, product title and price, and the existing Shop Now button. Use a cleaner editorial style than the first version, with a full-width image area, smaller horizontal benefit chips beneath the image on mobile, subtle borders, generous whitespace, and the theme’s existing typography and colors. Keep the benefit text editable with initial text “Smooth, easy application”, “Gentle on your skin”, and “Fast, effective results”. Make this a separate previewable section or block so it can be compared with the first version, and do not publish anything.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-editorial-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:#212326;background:#fff;font-family:var(--font-body-family,sans-serif)}
.ai-editorial-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:clamp(32px,6vw,96px);align-items:center;padding:clamp(28px,6vw,88px) clamp(20px,5vw,72px)}
.ai-editorial-{{ ai_gen_id }}__main{width:100%;aspect-ratio:1;display:block;object-fit:cover;background:#f3f3f3}.ai-editorial-{{ ai_gen_id }}__chips{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:16px}.ai-editorial-{{ ai_gen_id }}__chip{min-height:58px;padding:13px 14px;border:1px solid #d2d5d9;display:flex;align-items:center;justify-content:center;text-align:center;font-size:14px;line-height:1.35}.ai-editorial-{{ ai_gen_id }}__thumbs{display:flex;gap:10px;margin-top:16px;overflow-x:auto}.ai-editorial-{{ ai_gen_id }}__thumb{flex:0 0 70px;padding:0;border:1px solid #d2d5d9;background:#f3f3f3;cursor:pointer}.ai-editorial-{{ ai_gen_id }}__thumb.is-active{border:2px solid #212326}.ai-editorial-{{ ai_gen_id }}__thumb img{display:block;width:100%;aspect-ratio:1;object-fit:cover}.ai-editorial-{{ ai_gen_id }}__details{max-width:440px}.ai-editorial-{{ ai_gen_id }}__eyebrow{margin:0 0 14px;color:#5d6268;font-size:12px;letter-spacing:.12em;text-transform:uppercase}.ai-editorial-{{ ai_gen_id }}__title{margin:0 0 12px;color:#1a1b18;font-family:var(--font-heading-family,sans-serif);font-size:clamp(28px,4vw,50px);font-weight:400;line-height:1.05}.ai-editorial-{{ ai_gen_id }}__price{margin:0 0 28px;color:#1a1b18;font-size:18px}.ai-editorial-{{ ai_gen_id }}__button{display:inline-flex;width:100%;min-height:48px;align-items:center;justify-content:center;padding:12px 22px;border:1px solid #212326;border-radius:10px;background:#212326;color:#fff;font-size:13px;text-decoration:none}.ai-editorial-{{ ai_gen_id }}__thumb:focus-visible,.ai-editorial-{{ ai_gen_id }}__button:focus-visible{outline:3px solid #87adf5;outline-offset:3px}.ai-editorial-{{ ai_gen_id }}__placeholder{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:1;background:#f3f3f3;color:#6b7075}.ai-editorial-{{ ai_gen_id }}__placeholder svg{width:55%;height:55%}.ai-editorial-{{ ai_gen_id }}__empty{position:absolute;bottom:18px;width:calc(100% - 36px);text-align:center;font-size:13px}
@media(max-width:749px){.ai-editorial-{{ ai_gen_id }}__inner{display:block;padding:28px 16px 40px}.ai-editorial-{{ ai_gen_id }}__chips{display:flex;gap:8px;margin-top:12px;overflow-x:auto}.ai-editorial-{{ ai_gen_id }}__chip{flex:0 0 auto;min-height:auto;padding:9px 12px;white-space:nowrap;font-size:12px}.ai-editorial-{{ ai_gen_id }}__details{max-width:none;margin-top:36px}}
{% endstyle %}
<editorial-showcase-{{ ai_gen_id }} class="ai-editorial-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% assign featured_product = block.settings.product %}
{% if featured_product != blank %}{% assign featured_image = featured_product.featured_image %}<div class="ai-editorial-{{ ai_gen_id }}__inner"><div><img class="ai-editorial-{{ ai_gen_id }}__main" src="{{ featured_image | image_url: width: 1600 }}" alt="{{ featured_image.alt | default: featured_product.title | escape }}" width="{{ featured_image.width }}" height="{{ featured_image.height }}" loading="lazy"><div class="ai-editorial-{{ ai_gen_id }}__chips"><div class="ai-editorial-{{ ai_gen_id }}__chip">{{ block.settings.benefit_one }}</div><div class="ai-editorial-{{ ai_gen_id }}__chip">{{ block.settings.benefit_two }}</div><div class="ai-editorial-{{ ai_gen_id }}__chip">{{ block.settings.benefit_three }}</div></div><div class="ai-editorial-{{ ai_gen_id }}__thumbs" role="list" aria-label="Product media">{% for media in featured_product.media limit: 8 %}{% if media.media_type == 'image' %}<button class="ai-editorial-{{ ai_gen_id }}__thumb{% if forloop.first %} is-active{% endif %}" type="button" data-image="{{ media | image_url: width: 1600 }}" data-alt="{{ media.alt | default: featured_product.title | escape }}" aria-label="View product image {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><img src="{{ media | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy"></button>{% endif %}{% endfor %}</div></div><div class="ai-editorial-{{ ai_gen_id }}__details"><p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h2 class="ai-editorial-{{ ai_gen_id }}__title">{{ featured_product.title }}</h2><p class="ai-editorial-{{ ai_gen_id }}__price">{{ featured_product.price | money }}</p><a class="ai-editorial-{{ ai_gen_id }}__button" href="{{ featured_product.url }}">{{ block.settings.button_label }}</a></div></div>{% else %}<div class="ai-editorial-{{ ai_gen_id }}__inner"><div class="ai-editorial-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<div class="ai-editorial-{{ ai_gen_id }}__empty">Select a product to showcase this layout.</div></div><div class="ai-editorial-{{ ai_gen_id }}__details"><h2 class="ai-editorial-{{ ai_gen_id }}__title">Choose a featured product</h2></div></div>{% endif %}
</editorial-showcase-{{ ai_gen_id }}>
<script>(function(){class EditorialShowcase{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.image=this.querySelector('.ai-editorial-{{ ai_gen_id }}__main');this.thumbs=this.querySelectorAll('.ai-editorial-{{ ai_gen_id }}__thumb');this.thumbs.forEach((thumb)=>{thumb.addEventListener('click',()=>{this.image.src=thumb.dataset.image;this.image.alt=thumb.dataset.alt;this.thumbs.forEach((item)=>{item.classList.remove('is-active');item.setAttribute('aria-pressed','false')});thumb.classList.add('is-active');thumb.setAttribute('aria-pressed','true')})})}}if(!customElements.get('editorial-showcase-{{ ai_gen_id }}'))customElements.define('editorial-showcase-{{ ai_gen_id }}',EditorialShowcase{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Editorial showcase","settings":[{"type":"header","content":"Product"},{"type":"product","id":"product","label":"Featured product"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured collection"},{"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},{"type":"header","content":"Benefits"},{"type":"text","id":"benefit_one","label":"Benefit one","default":"Smooth, easy application"},{"type":"text","id":"benefit_two","label":"Benefit two","default":"Gentle on your skin"},{"type":"text","id":"benefit_three","label":"Benefit three","default":"Fast, effective results"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Editorial showcase"}],"tag":null,"class":"editorial-showcase-block"}{% endschema %}