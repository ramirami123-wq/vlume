{% doc %}
  @prompt
    Create a replacement featured-product showcase for the homepage using the current featured product’s real product media. Match the existing reference-style layout with a large product image, at least three clickable product-image thumbnails, and three stacked rounded benefit cards. Do not display the product price anywhere in this section. In the same section, place a social-proof zone where the price would normally appear: a compact rounded bordered box with five small overlapping circular avatar images and editable text reading “Lina, Noor and 200+ others love our products!”. Make the five avatar images, names, number, message, border/background colors, and spacing editable in the theme editor. Keep the product title, product gallery, benefit cards, and Shop Now button. Make it mobile-friendly, with the proof zone in a comfortable position beneath the product title or gallery. Do not publish anything.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign featured_product = block.settings.product %}

{% style %}
  .ai-featured-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.body_font.family }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(300px, .92fr);
    gap: 5rem;
    align-items: center;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__gallery {
    min-width: 0;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__main-image,
  .ai-featured-showcase-{{ ai_gen_id }}__placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_radius }}px;
    background: {{ block.settings.image_background }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__main-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__placeholder svg {
    width: 70%;
    height: 70%;
    opacity: .45;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__empty {
    position: absolute;
    bottom: 1.25rem;
    color: {{ block.settings.muted_color }};
    font-size: .85rem;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumbs {
    display: flex;
    gap: {{ block.settings.thumbnail_gap }}px;
    margin-top: 1rem;
    overflow-x: auto;
    padding-bottom: .25rem;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumb {
    flex: 0 0 {{ block.settings.thumbnail_size }}px;
    width: {{ block.settings.thumbnail_size }}px;
    height: {{ block.settings.thumbnail_size }}px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: {{ block.settings.thumbnail_radius }}px;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    cursor: pointer;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumb[aria-current="true"] {
    border-color: {{ block.settings.accent_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__title {
    margin: 0 0 1.25rem;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: clamp(1.8rem, 4vw, 3.3rem);
    line-height: 1.05;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__proof {
    display: flex;
    align-items: center;
    gap: .75rem;
    width: 100%;
    box-sizing: border-box;
    padding: .7rem .9rem;
    margin-bottom: 1.75rem;
    border: 1px solid {{ block.settings.proof_border_color }};
    border-radius: {{ block.settings.proof_radius }}px;
    background: {{ block.settings.proof_background_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__avatars {
    display: flex;
    flex: 0 0 auto;
    padding-left: 8px;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__avatar {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    margin-left: -8px;
    border: 2px solid {{ block.settings.proof_background_color }};
    border-radius: 50%;
    object-fit: cover;
    background: {{ block.settings.image_background }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__proof-text {
    margin: 0;
    font-size: .85rem;
    line-height: 1.3;
    color: {{ block.settings.proof_text_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__benefits {
    display: grid;
    gap: .75rem;
    width: 100%;
    margin-bottom: 1.75rem;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__benefit {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: 1rem 1.15rem;
    border-radius: {{ block.settings.benefit_radius }}px;
    background: {{ block.settings.benefit_background_color }};
    color: {{ block.settings.benefit_text_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__benefit-icon {
    display: grid;
    place-items: center;
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: {{ block.settings.benefit_icon_background }};
    color: {{ block.settings.benefit_icon_color }};
    font-size: .9rem;
    font-weight: 700;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__benefit p { margin: 0; font-size: .95rem; }

  .ai-featured-showcase-{{ ai_gen_id }}__button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 3.1rem;
    padding: .75rem 2rem;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-weight: 600;
    transition: opacity .2s ease;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__button:hover { opacity: .82; }
  .ai-featured-showcase-{{ ai_gen_id }}__button:focus-visible,
  .ai-featured-showcase-{{ ai_gen_id }}__thumb:focus-visible { outline: 3px solid {{ block.settings.focus_color }}; outline-offset: 3px; }

  @media screen and (max-width: 749px) {
    .ai-featured-showcase-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; gap: 2rem; }
    .ai-featured-showcase-{{ ai_gen_id }}__title { font-size: 2.2rem; }
    .ai-featured-showcase-{{ ai_gen_id }}__details { align-items: stretch; }
  }
{% endstyle %}

<featured-product-showcase-{{ ai_gen_id }} class="ai-featured-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-showcase-{{ ai_gen_id }}__grid">
    <div class="ai-featured-showcase-{{ ai_gen_id }}__gallery">
      {% if featured_product != blank and featured_product.media.size > 0 %}
        <div class="ai-featured-showcase-{{ ai_gen_id }}__main-image">
          <img src="{{ featured_product.media.first | image_url: width: 1400 }}" alt="{{ featured_product.media.first.alt | default: featured_product.title | escape }}" loading="lazy" width="{{ featured_product.media.first.width }}" height="{{ featured_product.media.first.height }}" data-main-image>
        </div>
        <div class="ai-featured-showcase-{{ ai_gen_id }}__thumbs" role="list" aria-label="Product images">
          {% for media in featured_product.media limit: 6 %}
            {% if media.media_type == 'image' %}
              <button type="button" class="ai-featured-showcase-{{ ai_gen_id }}__thumb" aria-label="View product image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-image="{{ media | image_url: width: 1400 }}" data-alt="{{ media.alt | default: featured_product.title | escape }}">
                <img src="{{ media | image_url: width: 180 }}" alt="" loading="lazy" width="180" height="180">
              </button>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-featured-showcase-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-featured-showcase-{{ ai_gen_id }}__empty">Choose a featured product to display its media</span></div>
      {% endif %}
    </div>

    <div class="ai-featured-showcase-{{ ai_gen_id }}__details">
      {% if featured_product != blank %}<h2 class="ai-featured-showcase-{{ ai_gen_id }}__title">{{ featured_product.title | escape }}</h2>{% endif %}
      <div class="ai-featured-showcase-{{ ai_gen_id }}__proof">
        <div class="ai-featured-showcase-{{ ai_gen_id }}__avatars">
          {% for i in (1..5) %}
            {% liquid
              assign avatar_key = 'avatar_' | append: i
              assign name_key = 'avatar_' | append: i | append: '_name'
              assign avatar = block.settings[avatar_key]
              assign avatar_name = block.settings[name_key]
            %}
            {% if avatar != blank %}<img class="ai-featured-showcase-{{ ai_gen_id }}__avatar" src="{{ avatar | image_url: width: 96 }}" alt="{{ avatar_name | escape }}" loading="lazy" width="96" height="96">{% endif %}
          {% endfor %}
        </div>
        <p class="ai-featured-showcase-{{ ai_gen_id }}__proof-text">{{ block.settings.proof_message | replace: 'Lina', block.settings.proof_name_1 | replace: 'Noor', block.settings.proof_name_2 | replace: '200+', block.settings.proof_number | escape }}</p>
      </div>
      <div class="ai-featured-showcase-{{ ai_gen_id }}__benefits">
        {% for i in (1..3) %}
          {% liquid
            assign benefit_key = 'benefit_' | append: i
            assign benefit = block.settings[benefit_key]
          %}
          <div class="ai-featured-showcase-{{ ai_gen_id }}__benefit"><span class="ai-featured-showcase-{{ ai_gen_id }}__benefit-icon">✓</span><p>{{ benefit | escape }}</p></div>
        {% endfor %}
      </div>
      {% if featured_product != blank %}<a class="ai-featured-showcase-{{ ai_gen_id }}__button" href="{{ featured_product.url }}">{{ block.settings.button_label | escape }}</a>{% endif %}
    </div>
  </div>
</featured-product-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedProductShowcase{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        const mainImage = this.querySelector('[data-main-image]');
        if (!mainImage) return;
        this.querySelectorAll('[data-image]').forEach((thumb) => {
          thumb.addEventListener('click', () => {
            mainImage.src = thumb.dataset.image;
            mainImage.alt = thumb.dataset.alt;
            this.querySelectorAll('[data-image]').forEach((item) => item.setAttribute('aria-current', 'false'));
            thumb.setAttribute('aria-current', 'true');
          });
        });
      }
    }
    if (!customElements.get('featured-product-showcase-{{ ai_gen_id }}')) customElements.define('featured-product-showcase-{{ ai_gen_id }}', FeaturedProductShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured product showcase",
  "tag": null,
  "class": "featured-product-showcase-block",
  "settings": [
    {"type":"header","content":"Product and layout"},
    {"type":"product","id":"product","label":"Featured product"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop now"},
    {"type":"header","content":"Social proof"},
    {"type":"text","id":"proof_message","label":"Message","default":"Lina, Noor and 200+ others love our products!"},
    {"type":"text","id":"proof_name_1","label":"First name","default":"Lina"},
    {"type":"text","id":"proof_name_2","label":"Second name","default":"Noor"},
    {"type":"text","id":"proof_number","label":"Number text","default":"200+"},
    {"type":"image_picker","id":"avatar_1","label":"Avatar 1"},
    {"type":"text","id":"avatar_1_name","label":"Avatar 1 name","default":"Lina"},
    {"type":"image_picker","id":"avatar_2","label":"Avatar 2"},
    {"type":"text","id":"avatar_2_name","label":"Avatar 2 name","default":"Noor"},
    {"type":"image_picker","id":"avatar_3","label":"Avatar 3"},
    {"type":"text","id":"avatar_3_name","label":"Avatar 3 name","default":"Maya"},
    {"type":"image_picker","id":"avatar_4","label":"Avatar 4"},
    {"type":"text","id":"avatar_4_name","label":"Avatar 4 name","default":"Sara"},
    {"type":"image_picker","id":"avatar_5","label":"Avatar 5"},
    {"type":"text","id":"avatar_5_name","label":"Avatar 5 name","default":"Rita"},
    {"type":"header","content":"Benefits"},
    {"type":"text","id":"benefit_1","label":"Benefit 1","default":"Premium quality ingredients"},
    {"type":"text","id":"benefit_2","label":"Benefit 2","default":"Made for your daily ritual"},
    {"type":"text","id":"benefit_3","label":"Benefit 3","default":"Loved by our community"},
    {"type":"header","content":"Colors and spacing"},
    {"type":"color","id":"heading_color","label":"Heading","default":"#1a1b18"},
    {"type":"color","id":"text_color","label":"Text","default":"#212326"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#1a1b18"},
    {"type":"color","id":"image_background","label":"Image background","default":"#f3f3f3"},
    {"type":"color","id":"muted_color","label":"Muted text","default":"#5c6166"},
    {"type":"color","id":"proof_border_color","label":"Proof border","default":"#d2d5d9"},
    {"type":"color","id":"proof_background_color","label":"Proof background","default":"#ffffff"},
    {"type":"color","id":"proof_text_color","label":"Proof text","default":"#212326"},
    {"type":"color","id":"benefit_background_color","label":"Benefit background","default":"#f3f3f3"},
    {"type":"color","id":"benefit_text_color","label":"Benefit text","default":"#212326"},
    {"type":"color","id":"benefit_icon_background","label":"Benefit icon background","default":"#1a1b18"},
    {"type":"color","id":"benefit_icon_color","label":"Benefit icon","default":"#ffffff"},
    {"type":"color","id":"button_background","label":"Button background","default":"#212326"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},
    {"type":"color","id":"focus_color","label":"Focus outline","default":"#87adf5"},
    {"type":"font_picker","id":"heading_font","label":"Heading font","default":"gill_sans_nova_n4"},
    {"type":"font_picker","id":"body_font","label":"Body font","default":"twentieth_century_n4"},
    {"type":"range","id":"proof_radius","label":"Proof radius","min":0,"max":40,"step":2,"unit":"px","default":14},
    {"type":"range","id":"benefit_radius","label":"Benefit radius","min":0,"max":40,"step":2,"unit":"px","default":14},
    {"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":10},
    {"type":"range","id":"image_radius","label":"Image radius","min":0,"max":40,"step":2,"unit":"px","default":14},
    {"type":"range","id":"thumbnail_radius","label":"Thumbnail radius","min":0,"max":30,"step":2,"unit":"px","default":8},
    {"type":"range","id":"thumbnail_size","label":"Thumbnail size","min":48,"max":120,"step":8,"unit":"px","default":72},
    {"type":"range","id":"thumbnail_gap","label":"Thumbnail spacing","min":2,"max":24,"step":2,"unit":"px","default":8},
    {"type":"range","id":"avatar_size","label":"Avatar size","min":20,"max":48,"step":2,"unit":"px","default":30}
  ],
  "presets": [{"name":"Featured product showcase"}]
}
{% endschema %}