{% doc %}
  @prompt
    Create a second, clearly different visual version of the featured-product media showcase for the homepage. Keep the same structure and current product media: a large product image, three editable benefit cards, thumbnails underneath, product title and price, and the existing Shop Now button. Use a cleaner editorial style than the first version, with a full-width image area, smaller horizontal benefit chips beneath the image on mobile, subtle borders, generous whitespace, and the theme’s existing typography and colors. Keep the benefit text editable with initial text “Smooth, easy application”, “Gentle on your skin”, and “Fast, effective results”. Make this a separate previewable section or block so it can be compared with the first version, and do not publish anything.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-editorial-showcase-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;color:{{ block.settings.text_color }};background:{{ block.settings.background_color }};font-family:inherit}.ai-editorial-showcase-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);gap:clamp(28px,6vw,96px);align-items:center;padding:clamp(24px,5vw,72px) clamp(16px,4vw,64px)}.ai-editorial-showcase-{{ ai_gen_id }}__main-image,.ai-editorial-showcase-{{ ai_gen_id }}__placeholder{display:block;width:100%;aspect-ratio:1/1;object-fit:contain;background:{{ block.settings.image_background }};color:{{ block.settings.muted_color }};border:0}.ai-editorial-showcase-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center}.ai-editorial-showcase-{{ ai_gen_id }}__placeholder svg{width:45%;height:45%}.ai-editorial-showcase-{{ ai_gen_id }}__empty{text-align:center;font-size:13px;margin-top:12px}.ai-editorial-showcase-{{ ai_gen_id }}__chips{display:grid;grid-template-columns:repeat(3,1fr);border-bottom:1px solid {{ block.settings.border_color }} }.ai-editorial-showcase-{{ ai_gen_id }}__chip{padding:16px 12px;border-right:1px solid {{ block.settings.border_color }};font-size:13px;line-height:1.4}.ai-editorial-showcase-{{ ai_gen_id }}__chip:last-child{border-right:0}.ai-editorial-showcase-{{ ai_gen_id }}__thumbs{display:flex;gap:10px;margin-top:14px;overflow-x:auto}.ai-editorial-showcase-{{ ai_gen_id }}__thumb{flex:0 0 64px;width:64px;height:64px;padding:0;border:1px solid {{ block.settings.border_color }};background:{{ block.settings.background_color }};cursor:pointer}.ai-editorial-showcase-{{ ai_gen_id }}__thumb[aria-current=true]{border:2px solid {{ block.settings.text_color }}}.ai-editorial-showcase-{{ ai_gen_id }}__thumb img{display:block;width:100%;height:100%;object-fit:cover}.ai-editorial-showcase-{{ ai_gen_id }}__details{border-top:1px solid {{ block.settings.border_color }};padding-top:22px}.ai-editorial-showcase-{{ ai_gen_id }}__title{margin:0 0 10px;color:{{ block.settings.heading_color }};font-size:clamp(24px,3vw,42px);line-height:1.1}.ai-editorial-showcase-{{ ai_gen_id }}__price{margin:0 0 26px;color:{{ block.settings.price_color }};font-size:18px}.ai-editorial-showcase-{{ ai_gen_id }}__button{display:inline-flex;justify-content:center;width:100%;padding:14px 22px;border:1px solid {{ block.settings.button_color }};border-radius:10px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};text-decoration:none;font:inherit;font-size:13px}.ai-editorial-showcase-{{ ai_gen_id }}__button:focus-visible,.ai-editorial-showcase-{{ ai_gen_id }}__thumb:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}@media screen and (max-width:749px){.ai-editorial-showcase-{{ ai_gen_id }}__inner{display:block;padding:24px 16px}.ai-editorial-showcase-{{ ai_gen_id }}__details{margin-top:28px}.ai-editorial-showcase-{{ ai_gen_id }}__chips{display:flex;gap:8px;border:0;overflow-x:auto;padding:16px 0 2px}.ai-editorial-showcase-{{ ai_gen_id }}__chip{flex:0 0 auto;max-width:72%;padding:9px 12px;border:1px solid {{ block.settings.border_color }};border-radius:999px;white-space:nowrap}}
{% endstyle %}
<product-editorial-showcase-{{ ai_gen_id }} class="ai-editorial-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-editorial-showcase-{{ ai_gen_id }}__inner"><div>{% if block.settings.product != blank and block.settings.product.featured_media != blank %}<img class="ai-editorial-showcase-{{ ai_gen_id }}__main-image" src="{{ block.settings.product.featured_media | image_url: width: 1600 }}" alt="{{ block.settings.product.featured_media.alt | default: block.settings.product.title | escape }}" loading="lazy" data-main-image><div class="ai-editorial-showcase-{{ ai_gen_id }}__chips"><div class="ai-editorial-showcase-{{ ai_gen_id }}__chip">{{ block.settings.benefit_one }}</div><div class="ai-editorial-showcase-{{ ai_gen_id }}__chip">{{ block.settings.benefit_two }}</div><div class="ai-editorial-showcase-{{ ai_gen_id }}__chip">{{ block.settings.benefit_three }}</div></div><div class="ai-editorial-showcase-{{ ai_gen_id }}__thumbs" aria-label="Product media">{% for media in block.settings.product.media %}{% if media.media_type == 'image' %}<button class="ai-editorial-showcase-{{ ai_gen_id }}__thumb" type="button" aria-label="View image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-image="{{ media | image_url: width: 1600 }}" data-alt="{{ media.alt | default: block.settings.product.title | escape }}"><img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy"></button>{% endif %}{% endfor %}</div>{% else %}<div class="ai-editorial-showcase-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div><div class="ai-editorial-showcase-{{ ai_gen_id }}__empty">Select a product to display its media.</div>{% endif %}</div><div class="ai-editorial-showcase-{{ ai_gen_id }}__details">{% if block.settings.product != blank %}<h2 class="ai-editorial-showcase-{{ ai_gen_id }}__title">{{ block.settings.product.title }}</h2><p class="ai-editorial-showcase-{{ ai_gen_id }}__price">{{ block.settings.product.price | money }}</p><a class="ai-editorial-showcase-{{ ai_gen_id }}__button" href="{{ block.settings.product.url }}">{{ block.settings.button_label }}</a>{% else %}<h2 class="ai-editorial-showcase-{{ ai_gen_id }}__title">{{ block.settings.placeholder_title }}</h2>{% endif %}</div></div></product-editorial-showcase-{{ ai_gen_id }}>
<script>(function(){class ProductEditorialShowcase{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.image=this.querySelector('[data-main-image]');this.buttons=this.querySelectorAll('[data-image]');this.buttons.forEach((button)=>button.addEventListener('click',()=>{if(!this.image)return;this.image.src=button.dataset.image;this.image.alt=button.dataset.alt;this.buttons.forEach((item)=>item.setAttribute('aria-current',item===button?'true':'false'))}))}}if(!customElements.get('product-editorial-showcase-{{ ai_gen_id }}'))customElements.define('product-editorial-showcase-{{ ai_gen_id }}',ProductEditorialShowcase{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Editorial showcase","settings":[{"type":"product","id":"product","label":"Product"},{"type":"text","id":"benefit_one","label":"Benefit one","default":"Smooth, easy application"},{"type":"text","id":"benefit_two","label":"Benefit two","default":"Gentle on your skin"},{"type":"text","id":"benefit_three","label":"Benefit three","default":"Fast, effective results"},{"type":"text","id":"button_label","label":"Button label","default":"Shop Now"},{"type":"text","id":"placeholder_title","label":"Empty title","default":"Featured product"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"image_background","label":"Image background","default":"#f3f3f3"},{"type":"color","id":"text_color","label":"Text","default":"#212326"},{"type":"color","id":"heading_color","label":"Heading","default":"#1a1b18"},{"type":"color","id":"price_color","label":"Price","default":"#1a1b18"},{"type":"color","id":"button_color","label":"Button","default":"#212326"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"border_color","label":"Borders","default":"#d2d5d9"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5f6368"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#1a73e8"}],"presets":[{"name":"Editorial showcase"}],"tag":null,"class":"editorial-product-showcase-block"}{% endschema %}