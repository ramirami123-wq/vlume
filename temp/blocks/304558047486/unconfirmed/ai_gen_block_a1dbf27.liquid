{% doc %}
  @prompt
    Create a customizable social-proof block for the Hair Removal Spray Foam product page. On mobile, place it directly between the product title/name and the product photo/media gallery. On desktop, place it in the closest equivalent position in the product information layout. Use a compact rounded bordered strip with five overlapping circular avatar images and editable text reading “Lina, Noor and 200+ others love our products!”. Make the names, 200+ number, message, five images, colors, border, and spacing editable in the theme editor. The block must be movable within the product page and should not alter the product title, product images, or purchase controls.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-social-proof-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-social-proof-{{ ai_gen_id }}__strip {
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
    width: 100%;
    box-sizing: border-box;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-social-proof-{{ ai_gen_id }}__avatars {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    padding-left: {{ block.settings.overlap }}px;
  }

  .ai-social-proof-{{ ai_gen_id }}__avatar,
  .ai-social-proof-{{ ai_gen_id }}__placeholder {
    position: relative;
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    flex: 0 0 {{ block.settings.avatar_size }}px;
    overflow: hidden;
    margin-left: -{{ block.settings.overlap }}px;
    border: {{ block.settings.avatar_border_width }}px solid {{ block.settings.avatar_border_color }};
    border-radius: 50%;
    background: {{ block.settings.placeholder_color }};
    box-sizing: content-box;
  }

  .ai-social-proof-{{ ai_gen_id }}__avatar img,
  .ai-social-proof-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-social-proof-{{ ai_gen_id }}__placeholder svg {
    color: {{ block.settings.placeholder_icon_color }};
  }

  .ai-social-proof-{{ ai_gen_id }}__message {
    min-width: 0;
    margin: 0;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .ai-social-proof-{{ ai_gen_id }}__name,
  .ai-social-proof-{{ ai_gen_id }}__count {
    color: {{ block.settings.highlight_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-social-proof-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-social-proof-{{ ai_gen_id }}__strip {
      padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-social-proof-{{ ai_gen_id }}__message {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<social-proof-{{ ai_gen_id }} class="ai-social-proof-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-social-proof-{{ ai_gen_id }}__strip" role="note" aria-label="{{ block.settings.name_one | escape }}, {{ block.settings.name_two | escape }} and {{ block.settings.people_count | escape }} {{ block.settings.message | escape }}">
    <div class="ai-social-proof-{{ ai_gen_id }}__avatars" aria-hidden="true">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'avatar_' | append: i
          assign avatar = block.settings[image_key]
        %}
        {% if avatar != blank %}
          <div class="ai-social-proof-{{ ai_gen_id }}__avatar">
            <img src="{{ avatar | image_url: width: 120 }}" alt="" loading="lazy" width="{{ block.settings.avatar_size }}" height="{{ block.settings.avatar_size }}">
          </div>
        {% else %}
          <div class="ai-social-proof-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <p class="ai-social-proof-{{ ai_gen_id }}__message">
      <span class="ai-social-proof-{{ ai_gen_id }}__name">{{ block.settings.name_one | escape }}, {{ block.settings.name_two | escape }}</span>
      {{ block.settings.connector | escape }}
      <span class="ai-social-proof-{{ ai_gen_id }}__count">{{ block.settings.people_count | escape }}</span>
      {{ block.settings.message | escape }}
    </p>
  </div>
</social-proof-{{ ai_gen_id }}>

<script>
  (function() {
    class SocialProof{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.setAttribute('data-social-proof-ready', 'true');
      }
    }
    if (!customElements.get('social-proof-{{ ai_gen_id }}')) {
      customElements.define('social-proof-{{ ai_gen_id }}', SocialProof{{ ai_gen_id }});
    }
  })();
</script>

