{% doc %}
  @prompt
    Create a mobile-first featured-product media showcase for the homepage, replacing or complementing the current Featured product presentation. Match the attached reference layout: show the selected product’s main image large on the left or top, three stacked rounded benefit cards beside it on desktop and below it on mobile, and the product’s image thumbnails underneath the main image. Use the current featured product’s real product media, not the reference product. Make the three benefit card texts editable and set initial text to “Smooth, easy application”, “Gentle on your skin”, and “Fast, effective results”. Include small checkmark icons, rounded corners, clean spacing, and use the theme’s existing typography and colors. Keep the product title, price, and existing Shop Now button available in the featured product section. Use the attached screenshot only as visual inspiration: https://sidekick.shopify.ai/rails/active_storage/blobs/redirect/eyJfcmFpbHMiOnsiZGF0YSI6MzU2MDE3ODI3NywicHVyIjoiYmxvYl9pZCJ9fQ==--5826427346853563fc62c5802ee97dc1384d03f3/2.jpeg
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-showcase-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr);
    gap: 32px;
    align-items: start;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__media {
    min-width: 0;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__main {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    border-radius: {{ block.settings.image_radius }}px;
    background: {{ block.settings.image_background }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__main img,
  .ai-featured-showcase-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
    padding: 15%;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    padding: 10px 12px;
    border-radius: 8px;
    background: rgba(255,255,255,.9);
    color: {{ block.settings.text_color }};
    font-size: 13px;
    text-align: center;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
    padding: 2px;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumb {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    padding: 4px;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 10px;
    background: {{ block.settings.image_background }};
    cursor: pointer;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumb[aria-current="true"] {
    border: 2px solid {{ block.settings.accent_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: clamp(25px, 3vw, 38px);
    line-height: 1.12;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__price {
    color: {{ block.settings.price_color }};
    font-size: 20px;
    font-weight: 600;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__benefits {
    display: grid;
    gap: 12px;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__benefit {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 58px;
    padding: 14px 16px;
    border-radius: {{ block.settings.card_radius }}px;
    background: {{ block.settings.card_background }};
    color: {{ block.settings.card_text_color }};
  }

  .ai-featured-showcase-{{ ai_gen_id }}__check {
    display: inline-flex;
    flex: 0 0 22px;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: {{ block.settings.check_background }};
    color: {{ block.settings.check_color }};
    font-size: 14px;
    font-weight: 700;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    font-weight: 600;
    text-align: center;
  }

  .ai-featured-showcase-{{ ai_gen_id }}__button:focus-visible,
  .ai-featured-showcase-{{ ai_gen_id }}__thumb:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .ai-featured-showcase-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-featured-showcase-{{ ai_gen_id }}__layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .ai-featured-showcase-{{ ai_gen_id }}__details {
      gap: 16px;
    }
  }
{% endstyle %}

<featured-media-showcase-{{ ai_gen_id }} class="ai-featured-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% assign featured_product = block.settings.product %}
  {% if featured_product != blank %}
    <div class="ai-featured-showcase-{{ ai_gen_id }}__layout">
      <div class="ai-featured-showcase-{{ ai_gen_id }}__media">
        <div class="ai-featured-showcase-{{ ai_gen_id }}__main">
          {% assign first_media = featured_product.media.first %}
          {% if first_media != blank %}
            <img src="{{ first_media | image_url: width: 1400 }}" alt="{{ first_media.alt | default: featured_product.title | escape }}" width="{{ first_media.preview_image.width }}" height="{{ first_media.preview_image.height }}" data-main-image loading="lazy">
          {% else %}
            <div class="ai-featured-showcase-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            <div class="ai-featured-showcase-{{ ai_gen_id }}__empty">Add product media to display the showcase.</div>
          {% endif %}
        </div>
        {% if featured_product.media.size > 1 %}
          <div class="ai-featured-showcase-{{ ai_gen_id }}__thumbs" aria-label="Product media">
            {% for media in featured_product.media %}
              {% if media.preview_image != blank %}
                <button class="ai-featured-showcase-{{ ai_gen_id }}__thumb" type="button" aria-label="View {{ featured_product.title | escape }} image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-image-url="{{ media | image_url: width: 1400 }}" data-image-alt="{{ media.alt | default: featured_product.title | escape }}">
                  <img src="{{ media | image_url: width: 160 }}" alt="" width="160" height="160" loading="lazy">
                </button>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
      <div class="ai-featured-showcase-{{ ai_gen_id }}__details">
        <div>
          <h2 class="ai-featured-showcase-{{ ai_gen_id }}__title">{{ featured_product.title }}</h2>
          <div class="ai-featured-showcase-{{ ai_gen_id }}__price">{{ featured_product.price | money }}</div>
        </div>
        <div class="ai-featured-showcase-{{ ai_gen_id }}__benefits">
          {% for benefit in (1..3) %}
            {% assign benefit_key = 'benefit_' | append: benefit %}
            <div class="ai-featured-showcase-{{ ai_gen_id }}__benefit"><span class="ai-featured-showcase-{{ ai_gen_id }}__check" aria-hidden="true">✓</span><span>{{ block.settings[benefit_key] }}</span></div>
          {% endfor %}
        </div>
        <a class="ai-featured-showcase-{{ ai_gen_id }}__button" href="{{ featured_product.url }}">{{ block.settings.button_label }}</a>
      </div>
    </div>
  {% else %}
    <div class="ai-featured-showcase-{{ ai_gen_id }}__main"><div class="ai-featured-showcase-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="ai-featured-showcase-{{ ai_gen_id }}__empty">Select a product to build your featured showcase.</div></div>
  {% endif %}
</featured-media-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedMediaShowcase{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.mainImage = this.querySelector('[data-main-image]');
        this.thumbnails = this.querySelectorAll('[data-image-url]');
        this.thumbnails.forEach((thumbnail) => {
          thumbnail.addEventListener('click', () => {
            if (!this.mainImage) return;
            this.mainImage.src = thumbnail.dataset.imageUrl;
            this.mainImage.alt = thumbnail.dataset.imageAlt;
            this.thumbnails.forEach((item) => item.setAttribute('aria-current', 'false'));
            thumbnail.setAttribute('aria-current', 'true');
          });
        });
      }
    }
    if (!customElements.get('featured-media-showcase-{{ ai_gen_id }}')) customElements.define('featured-media-showcase-{{ ai_gen_id }}', FeaturedMediaShowcase{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured media showcase",
  "tag": null,
  "class": "featured-media-showcase-block",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Featured product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "header", "content": "Benefits" },
    { "type": "text", "id": "benefit_1", "label": "Benefit one", "default": "Smooth, easy application" },
    { "type": "text", "id": "benefit_2", "label": "Benefit two", "default": "Gentle on your skin" },
    { "type": "text", "id": "benefit_3", "label": "Benefit three", "default": "Fast, effective results" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "image_radius", "label": "Image corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "card_radius", "label": "Card corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "button_radius", "label": "Button corners", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f3f3f3" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#f3f3f3" },
    { "type": "color", "id": "card_text_color", "label": "Card text", "default": "#212326" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#212326" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1b18" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#1a1b18" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#d2d5d9" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1a1b18" },
    { "type": "color", "id": "check_background", "label": "Check background", "default": "#1a1b18" },
    { "type": "color", "id": "check_color", "label": "Check icon", "default": "#ffffff" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#1a1b18" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#87adf5" }
  ],
  "presets": [{ "name": "Featured media showcase" }]
}
{% endschema %}