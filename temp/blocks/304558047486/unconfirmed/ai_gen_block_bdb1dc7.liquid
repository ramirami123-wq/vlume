{% doc %}
  @prompt
    Create a new homepage image slideshow block that copies the current image slide design, including its existing text, buttons, layout, and styling. Add support for many image sections as individual slides, keep the same text content across the slides, and make the slides rotate automatically. Include optional previous/next controls and slide indicators, with a polished responsive layout for mobile and desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-slideshow-{{ ai_gen_id }}{display:block;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;overflow:hidden;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-slideshow-{{ ai_gen_id }}__viewport{position:relative;min-height:{{ block.settings.desktop_height }}px}.ai-slideshow-{{ ai_gen_id }}__slide{position:absolute;inset:0;display:flex;align-items:{{ block.settings.content_position }};justify-content:{{ block.settings.content_alignment }};opacity:0;visibility:hidden;transition:opacity .45s ease}.ai-slideshow-{{ ai_gen_id }}__slide.is-active{position:relative;opacity:1;visibility:visible;z-index:1}.ai-slideshow-{{ ai_gen_id }}__media,.ai-slideshow-{{ ai_gen_id }}__media img,.ai-slideshow-{{ ai_gen_id }}__placeholder{position:absolute;inset:0;width:100%;height:100%}.ai-slideshow-{{ ai_gen_id }}__media img{object-fit:cover}.ai-slideshow-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:{{ block.settings.placeholder_color }}}.ai-slideshow-{{ ai_gen_id }}__placeholder svg{width:42%;height:42%;color:{{ block.settings.muted_text_color }}}.ai-slideshow-{{ ai_gen_id }}__shade{position:absolute;inset:0;background:{{ block.settings.overlay_color }};opacity:{{ block.settings.overlay_opacity | divided_by:100.0 }}}.ai-slideshow-{{ ai_gen_id }}__content{position:relative;z-index:2;width:min(600px,90%);padding:48px 32px;text-align:{{ block.settings.text_alignment }}}.ai-slideshow-{{ ai_gen_id }}__heading{margin:0 0 14px;color:inherit;font-family:{{ block.settings.heading_font.family }};font-size:clamp(28px,4vw,{{ block.settings.heading_size }}px);line-height:1.08}.ai-slideshow-{{ ai_gen_id }}__text{margin:0 0 24px;color:inherit;font-size:{{ block.settings.text_size }}px;line-height:1.5}.ai-slideshow-{{ ai_gen_id }}__actions{display:flex;flex-wrap:wrap;gap:12px;justify-content:{% if block.settings.text_alignment == 'center' %}center{% elsif block.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %}}.ai-slideshow-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:12px 22px;border:{{ block.settings.button_border_width }}px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:14px;font-weight:600;text-decoration:none}.ai-slideshow-{{ ai_gen_id }}__button--secondary{background:transparent;color:{{ block.settings.secondary_button_text_color }};border-color:{{ block.settings.secondary_button_color }}}.ai-slideshow-{{ ai_gen_id }}__controls{position:absolute;z-index:3;right:24px;bottom:24px;display:flex;align-items:center;gap:10px}.ai-slideshow-{{ ai_gen_id }}__arrow,.ai-slideshow-{{ ai_gen_id }}__dot{border:1px solid {{ block.settings.control_color }};background:{{ block.settings.control_background }};color:{{ block.settings.control_color }};cursor:pointer}.ai-slideshow-{{ ai_gen_id }}__arrow{width:38px;height:38px;border-radius:50%;font-size:20px}.ai-slideshow-{{ ai_gen_id }}__dots{display:flex;gap:7px}.ai-slideshow-{{ ai_gen_id }}__dot{width:9px;height:9px;padding:0;border-radius:50%}.ai-slideshow-{{ ai_gen_id }}__dot.is-active{background:{{ block.settings.control_color }}}.ai-slideshow-{{ ai_gen_id }}__arrow:focus-visible,.ai-slideshow-{{ ai_gen_id }}__dot:focus-visible,.ai-slideshow-{{ ai_gen_id }}__button:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}@media(max-width:749px){.ai-slideshow-{{ ai_gen_id }}__viewport{min-height:{{ block.settings.mobile_height }}px}.ai-slideshow-{{ ai_gen_id }}__content{padding:36px 20px 76px}.ai-slideshow-{{ ai_gen_id }}__controls{right:16px;bottom:16px}}
{% endstyle %}
<image-slideshow-{{ ai_gen_id }} class="ai-slideshow-{{ ai_gen_id }}" data-interval="{% if block.settings.autoplay %}{{ block.settings.autoplay_seconds | times:1000 }}{% else %}0{% endif %}" {{ block.shopify_attributes }}><div class="ai-slideshow-{{ ai_gen_id }}__viewport" role="region" aria-label="{{ block.settings.accessibility_label | escape }}" aria-live="polite">{% for i in (1..6) %}{% assign image_key='image_' | append:i %}{% assign image=block.settings[image_key] %}<div class="ai-slideshow-{{ ai_gen_id }}__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ forloop.index0 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"><div class="ai-slideshow-{{ ai_gen_id }}__media">{% if image != blank %}<img src="{{ image | image_url:width:2400 }}" alt="{{ image.alt | default:block.settings.heading | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">{% else %}<div class="ai-slideshow-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-slideshow-{{ ai_gen_id }}__shade"></div><div class="ai-slideshow-{{ ai_gen_id }}__content">{% if block.settings.heading != blank %}<h2 class="ai-slideshow-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}{% if block.settings.text != blank %}<div class="ai-slideshow-{{ ai_gen_id }}__text">{{ block.settings.text }}</div>{% endif %}<div class="ai-slideshow-{{ ai_gen_id }}__actions">{% if block.settings.primary_label != blank and block.settings.primary_link != blank %}<a class="ai-slideshow-{{ ai_gen_id }}__button" href="{{ block.settings.primary_link }}">{{ block.settings.primary_label }}</a>{% endif %}{% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}<a class="ai-slideshow-{{ ai_gen_id }}__button ai-slideshow-{{ ai_gen_id }}__button--secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }}</a>{% endif %}</div></div></div>{% endfor %}{% if block.settings.show_controls %}<div class="ai-slideshow-{{ ai_gen_id }}__controls"><button class="ai-slideshow-{{ ai_gen_id }}__arrow" type="button" data-direction="previous" aria-label="Previous slide">&#8592;</button>{% if block.settings.show_indicators %}<div class="ai-slideshow-{{ ai_gen_id }}__dots">{% for i in (1..6) %}<button class="ai-slideshow-{{ ai_gen_id }}__dot{% if forloop.first %} is-active{% endif %}" type="button" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>{% endfor %}</div>{% endif %}<button class="ai-slideshow-{{ ai_gen_id }}__arrow" type="button" data-direction="next" aria-label="Next slide">&#8594;</button></div>{% endif %}</div></image-slideshow-{{ ai_gen_id }}>
<script>(function(){class S{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.s=[...this.querySelectorAll('[data-slide]')];this.d=[...this.querySelectorAll('[data-index]')];this.i=0;this.querySelectorAll('[data-direction]').forEach(b=>b.onclick=()=>this.go(this.i+(b.dataset.direction==='next'?1:-1)));this.d.forEach(b=>b.onclick=()=>this.go(+b.dataset.index));if(+this.dataset.interval)this.t=setInterval(()=>this.go(this.i+1),+this.dataset.interval)}go(n){this.i=(n+this.s.length)%this.s.length;this.s.forEach((e,i)=>{e.classList.toggle('is-active',i===this.i);e.setAttribute('aria-hidden',i===this.i?'false':'true')});this.d.forEach((e,i)=>e.classList.toggle('is-active',i===this.i))}}customElements.define('image-slideshow-{{ ai_gen_id }}',S{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Homepage image slideshow","settings":[{"type":"text","id":"heading","label":"Heading","default":"Made for your everyday ritual"},{"type":"textarea","id":"text","label":"Text","default":"Discover products designed to fit beautifully into your routine."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop now"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Learn more"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"image_picker","id":"image_1","label":"Slide image 1"},{"type":"image_picker","id":"image_2","label":"Slide image 2"},{"type":"image_picker","id":"image_3","label":"Slide image 3"},{"type":"image_picker","id":"image_4","label":"Slide image 4"},{"type":"image_picker","id":"image_5","label":"Slide image 5"},{"type":"image_picker","id":"image_6","label":"Slide image 6"},{"type":"checkbox","id":"autoplay","label":"Rotate automatically","default":true},{"type":"range","id":"autoplay_seconds","label":"Time per slide","min":3,"max":15,"step":1,"unit":"s","default":6},{"type":"checkbox","id":"show_controls","label":"Show previous and next","default":true},{"type":"checkbox","id":"show_indicators","label":"Show slide indicators","default":true},{"type":"text","id":"accessibility_label","label":"Accessibility label","default":"Featured content slideshow"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_height","label":"Desktop height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"mobile_height","label":"Mobile height","min":300,"max":700,"step":50,"unit":"px","default":500},{"type":"select","id":"content_position","label":"Content vertical position","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"select","id":"content_alignment","label":"Content horizontal position","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"gill_sans_nova_n4"},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":72,"step":4,"unit":"px","default":48},{"type":"range","id":"text_size","label":"Text size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"overlay_color","label":"Overlay","default":"#212326"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":35},{"type":"color","id":"placeholder_color","label":"Placeholder","default":"#f3f3f3"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#5f6368"},{"type":"color","id":"button_color","label":"Primary button","default":"#1a1b18"},{"type":"color","id":"button_text_color","label":"Primary button text","default":"#ffffff"},{"type":"color","id":"secondary_button_color","label":"Secondary button","default":"#ffffff"},{"type":"color","id":"secondary_button_text_color","label":"Secondary button text","default":"#ffffff"},{"type":"color","id":"control_color","label":"Controls","default":"#ffffff"},{"type":"color","id":"control_background","label":"Control background","default":"#212326"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#87adf5"},{"type":"range","id":"button_border_width","label":"Button border","min":0,"max":4,"step":1,"unit":"px","default":1},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":20,"step":2,"unit":"px","default":10}],"presets":[{"name":"Homepage image slideshow"}],"tag":null,"class":"homepage-image-slideshow"}{% endschema %}