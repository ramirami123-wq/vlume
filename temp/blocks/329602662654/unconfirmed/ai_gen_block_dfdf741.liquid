{% doc %}
  @prompt
    Create a mobile-friendly one-click offer selector for Hair Removal Spray Foam and place it at the top of the product page, directly below the product title and price and above the product description and other purchase sections. Use product variant ID 48167019741438. Include exactly three clearly separated buttons: 1 Bottle for $16 with customer-paid shipping and quantity 1; 2 Bottles for $32 with free shipping, labeled Most Popular and highlighted by default, with quantity 2; and 3 Bottles for $44 with free shipping, labeled Best Value, with quantity 3. When a customer clicks an offer once, add the exact corresponding quantity and take them directly to Shopify checkout, skipping the cart page. Preserve Shopify checkout compatibility and allow the store’s automatic product and shipping discounts to apply. Prevent duplicate quantities from any existing cart contents. Keep the design consistent with Vlume, accessible, fast, and optimized for mobile. Do not display $43 anywhere. Include editable offer labels and prices, but keep the product variant and quantities correctly connected.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-offer-selector-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #212326;
    font-family: inherit;
    margin: 16px 0;
  }
  .ai-offer-selector-{{ ai_gen_id }}__heading { margin: 0 0 10px; color: #1a1b18; font-size: 16px; font-weight: 700; }
  .ai-offer-selector-{{ ai_gen_id }}__list { display: grid; gap: 10px; }
  .ai-offer-selector-{{ ai_gen_id }}__button {
    appearance: none; position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px;
    width: 100%; min-height: 70px; padding: 13px 15px; border: 1px solid #d2d5d9; border-radius: 10px;
    background: #fff; color: #212326; text-align: left; font: inherit; cursor: pointer;
  }
  .ai-offer-selector-{{ ai_gen_id }}__button[aria-pressed="true"] { border: 2px solid #212326; background: #f3f3f3; }
  .ai-offer-selector-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #315da8; outline-offset: 3px; }
  .ai-offer-selector-{{ ai_gen_id }}__details { display: flex; flex-direction: column; gap: 4px; }
  .ai-offer-selector-{{ ai_gen_id }}__label { font-weight: 700; line-height: 1.25; }
  .ai-offer-selector-{{ ai_gen_id }}__shipping { font-size: 13px; color: #45484b; }
  .ai-offer-selector-{{ ai_gen_id }}__price { flex-shrink: 0; font-size: 18px; font-weight: 700; color: #1a1b18; }
  .ai-offer-selector-{{ ai_gen_id }}__badge { position: absolute; top: -9px; right: 10px; padding: 2px 8px; border-radius: 20px; background: #212326; color: #fff; font-size: 11px; font-weight: 700; }
  .ai-offer-selector-{{ ai_gen_id }}__status { min-height: 1.3em; margin: 8px 0 0; font-size: 13px; color: #212326; }
  .ai-offer-selector-{{ ai_gen_id }}__button[disabled] { opacity: .65; cursor: wait; }
  @media (max-width: 749px) { .ai-offer-selector-{{ ai_gen_id }} { width: 100%; } .ai-offer-selector-{{ ai_gen_id }}__button { min-height: 68px; padding: 12px; } }
{% endstyle %}

<offer-selector-{{ ai_gen_id }} class="ai-offer-selector-{{ ai_gen_id }}" data-variant-id="48167019741438" {{ block.shopify_attributes }}>
  <h2 class="ai-offer-selector-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  <div class="ai-offer-selector-{{ ai_gen_id }}__list" role="group" aria-label="Choose an offer">
    <button type="button" class="ai-offer-selector-{{ ai_gen_id }}__button" data-quantity="1" data-offer="one" aria-pressed="false">
      <span class="ai-offer-selector-{{ ai_gen_id }}__details"><span class="ai-offer-selector-{{ ai_gen_id }}__label">{{ block.settings.offer_one_label | escape }}</span><span class="ai-offer-selector-{{ ai_gen_id }}__shipping">{{ block.settings.shipping_one | escape }}</span></span>
      <span class="ai-offer-selector-{{ ai_gen_id }}__price">{{ block.settings.price_one | escape }}</span>
    </button>
    <button type="button" class="ai-offer-selector-{{ ai_gen_id }}__button" data-quantity="2" data-offer="two" aria-pressed="true">
      <span class="ai-offer-selector-{{ ai_gen_id }}__badge">{{ block.settings.badge_two | escape }}</span>
      <span class="ai-offer-selector-{{ ai_gen_id }}__details"><span class="ai-offer-selector-{{ ai_gen_id }}__label">{{ block.settings.offer_two_label | escape }}</span><span class="ai-offer-selector-{{ ai_gen_id }}__shipping">{{ block.settings.shipping_free | escape }}</span></span>
      <span class="ai-offer-selector-{{ ai_gen_id }}__price">{{ block.settings.price_two | escape }}</span>
    </button>
    <button type="button" class="ai-offer-selector-{{ ai_gen_id }}__button" data-quantity="3" data-offer="three" aria-pressed="false">
      <span class="ai-offer-selector-{{ ai_gen_id }}__badge">{{ block.settings.badge_three | escape }}</span>
      <span class="ai-offer-selector-{{ ai_gen_id }}__details"><span class="ai-offer-selector-{{ ai_gen_id }}__label">{{ block.settings.offer_three_label | escape }}</span><span class="ai-offer-selector-{{ ai_gen_id }}__shipping">{{ block.settings.shipping_free | escape }}</span></span>
      <span class="ai-offer-selector-{{ ai_gen_id }}__price">{{ block.settings.price_three | escape }}</span>
    </button>
  </div>
  <p class="ai-offer-selector-{{ ai_gen_id }}__status" aria-live="polite" role="status"></p>
</offer-selector-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'offer-selector-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class OfferSelector extends HTMLElement {
      connectedCallback() {
        this.buttons = Array.from(this.querySelectorAll('button[data-quantity]'));
        this.status = this.querySelector('[role="status"]');
        this.buttons.forEach((button) => button.addEventListener('click', () => this.addOffer(button)));
      }
      async addOffer(selected) {
        if (this.busy) return;
        this.busy = true;
        this.buttons.forEach((button) => button.disabled = true);
        this.buttons.forEach((button) => button.setAttribute('aria-pressed', button === selected ? 'true' : 'false'));
        this.status.textContent = 'Preparing checkout…';
        try {
          const variantId = this.dataset.variantId;
          const quantity = Number(selected.dataset.quantity);
          const cartResponse = await fetch('/cart.js', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
          if (!cartResponse.ok) throw new Error('Cart could not be checked.');
          const cart = await cartResponse.json();
          const removeItems = cart.items.filter((item) => String(item.variant_id) === variantId).map((item) => ({ id: item.key, quantity: 0 }));
          if (removeItems.length) {
            const updateResponse = await fetch('/cart/update.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ updates: Object.fromEntries(removeItems.map((item) => [item.id, item.quantity])) }) });
            if (!updateResponse.ok) throw new Error('Existing item could not be replaced.');
          }
          const addResponse = await fetch('/cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: Number(variantId), quantity: quantity }] }) });
          if (!addResponse.ok) throw new Error('This offer could not be added. Please try again.');
          window.location.assign('/checkout');
        } catch (error) {
          this.status.textContent = error.message || 'Checkout could not be opened. Please try again.';
          this.buttons.forEach((button) => button.disabled = false);
          this.busy = false;
        }
      }
    }
    customElements.define(tagName, OfferSelector);
  })();
</script>

{% schema %}
{
  "name": "One-click offer selector",
  "settings": [
    { "type": "header", "content": "Offers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your offer" },
    { "type": "text", "id": "offer_one_label", "label": "1-bottle label", "default": "1 Bottle · Quantity 1" },
    { "type": "text", "id": "price_one", "label": "1-bottle price", "default": "$16" },
    { "type": "text", "id": "shipping_one", "label": "1-bottle shipping", "default": "Shipping paid by customer" },
    { "type": "text", "id": "offer_two_label", "label": "2-bottle label", "default": "2 Bottles · Quantity 2" },
    { "type": "text", "id": "price_two", "label": "2-bottle price", "default": "$32" },
    { "type": "text", "id": "badge_two", "label": "2-bottle badge", "default": "Most Popular" },
    { "type": "text", "id": "offer_three_label", "label": "3-bottle label", "default": "3 Bottles · Quantity 3" },
    { "type": "text", "id": "price_three", "label": "3-bottle price", "default": "$44" },
    { "type": "text", "id": "badge_three", "label": "3-bottle badge", "default": "Best Value" },
    { "type": "text", "id": "shipping_free", "label": "Free-shipping message", "default": "Free shipping" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "One-click offer selector" }],
  "tag": null,
  "class": "one-click-offer-selector"
}
{% endschema %}