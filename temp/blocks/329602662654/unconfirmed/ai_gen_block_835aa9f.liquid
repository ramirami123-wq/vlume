{% doc %}
  @prompt
    Create a replacement mobile-friendly one-click offer selector for Hair Removal Spray Foam, designed to match the currently selected One-click offer selector exactly. Preserve its current visual style, colors, typography, spacing, button shape, offer-card layout, badges, units, accessibility, and fast mobile behavior. Preserve all existing options and behavior: a single click adds the exact selected quantity, goes directly to Shopify checkout while skipping the cart page, prevents duplicate quantities from existing cart contents, remains compatible with Shopify checkout, and allows the store’s automatic product and shipping discounts to apply. Use product variant ID 48167019741438. Change only the offers to exactly: 1 Bottle for $16 with customer-paid shipping and quantity 1; 2 Bottles for $32 with free shipping, labeled Most Popular and highlighted by default, with quantity 2; 3 Bottles for $44 with free shipping, labeled Best Value, with quantity 3. Do not display $43 anywhere. Keep the offer labels and prices editable while keeping the product variant and quantities correctly connected. Place the replacement in the same product-page purchase area as the selected old offer block so it can replace it., i want the same colors and text type of the old offers
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-offer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    color: {{ settings.colors_text }};
    font-size: 14px;
  }
  .ai-offer-{{ ai_gen_id }}__heading { margin: 0 0 12px; color: {{ settings.colors_heading }}; font-family: {{ settings.type_header_font.family }}, sans-serif; font-size: 18px; font-weight: 600; }
  .ai-offer-{{ ai_gen_id }}__options { display: grid; gap: 10px; }
  .ai-offer-{{ ai_gen_id }}__card { position: relative; display: flex; align-items: center; gap: 12px; min-height: 66px; padding: 12px 14px; border: 1px solid {{ settings.colors_border }}; border-radius: {{ settings.button_corner_radius }}px; background: {{ settings.colors_background }}; color: {{ settings.colors_text }}; cursor: pointer; text-align: left; width: 100%; font-family: {{ settings.type_body_font.family }}, sans-serif; font-size: 14px; }
  .ai-offer-{{ ai_gen_id }}__card:focus-visible, .ai-offer-{{ ai_gen_id }}__submit:focus-visible { outline: 3px solid {{ settings.colors_keyboard_focus }}; outline-offset: 3px; }
  .ai-offer-{{ ai_gen_id }}__card[aria-checked="true"] { border: 2px solid {{ settings.colors_accent }}; background: {{ settings.colors_img_background }}; }
  .ai-offer-{{ ai_gen_id }}__radio { width: 18px; height: 18px; flex: 0 0 18px; border: 1.5px solid {{ settings.colors_accent }}; border-radius: 50%; display: grid; place-items: center; }
  .ai-offer-{{ ai_gen_id }}__card[aria-checked="true"] .ai-offer-{{ ai_gen_id }}__radio:after { content: ''; width: 9px; height: 9px; border-radius: 50%; background: {{ settings.colors_accent }}; }
  .ai-offer-{{ ai_gen_id }}__details { min-width: 0; flex: 1; }
  .ai-offer-{{ ai_gen_id }}__label { display: block; font-weight: 600; }
  .ai-offer-{{ ai_gen_id }}__unit { display: block; margin-top: 3px; font-size: 13px; color: {{ settings.colors_text }}; }
  .ai-offer-{{ ai_gen_id }}__price { white-space: nowrap; color: {{ settings.colors_price }}; font-family: {{ settings.type_header_font.family }}, sans-serif; font-weight: 700; font-size: 17px; }
  .ai-offer-{{ ai_gen_id }}__badge { position: absolute; right: 12px; top: -9px; padding: 3px 8px; border-radius: 3px; background: {{ settings.colors_sale_badge_background }}; color: {{ settings.colors_solid_button_labels }}; font-family: {{ settings.type_body_font.family }}, sans-serif; font-size: 10px; line-height: 1.2; font-weight: 700; letter-spacing: .04em; }
  .ai-offer-{{ ai_gen_id }}__card:has(.ai-offer-{{ ai_gen_id }}__badge) .ai-offer-{{ ai_gen_id }}__price { margin-top: 8px; }
  .ai-offer-{{ ai_gen_id }}__submit { display: block; width: 100%; min-height: 50px; margin-top: 14px; padding: 12px 18px; border: 0; border-radius: {{ settings.button_corner_radius }}px; background: {{ settings.colors_accent }}; color: {{ settings.colors_solid_button_labels }}; font-family: {{ settings.type_body_font.family }}, sans-serif; font-size: {{ settings.type_button_size }}px; font-weight: 700; cursor: pointer; }
  .ai-offer-{{ ai_gen_id }}__submit:disabled { opacity: .65; cursor: wait; }
  .ai-offer-{{ ai_gen_id }}__error { margin: 10px 0 0; color: {{ settings.colors_sale_price }}; font-size: 14px; }
  @media (max-width: 749px) { .ai-offer-{{ ai_gen_id }} { width: 100%; } .ai-offer-{{ ai_gen_id }}__card { min-height: 62px; padding: 11px 12px; } }
{% endstyle %}

<one-click-offer-{{ ai_gen_id }} class="ai-offer-{{ ai_gen_id }}" data-variant-id="48167019741438" data-error="{{ block.settings.error_message | escape }}" {{ block.shopify_attributes }}>
  <h3 class="ai-offer-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h3>
  <div class="ai-offer-{{ ai_gen_id }}__options" role="radiogroup" aria-label="{{ block.settings.heading | escape }}">
    {% for i in (1..3) %}
      {% liquid
        assign label_key = 'offer_' | append: i | append: '_label'
        assign price_key = 'offer_' | append: i | append: '_price'
        assign unit_key = 'offer_' | append: i | append: '_unit'
        assign badge_key = 'offer_' | append: i | append: '_badge'
        assign label_value = block.settings[label_key]
        assign price_value = block.settings[price_key]
        assign unit_value = block.settings[unit_key]
        assign badge_value = block.settings[badge_key]
      %}
      <button type="button" class="ai-offer-{{ ai_gen_id }}__card" role="radio" aria-checked="{% if i == 2 %}true{% else %}false{% endif %}" data-quantity="{{ i }}" data-offer-index="{{ i }}">
        <span class="ai-offer-{{ ai_gen_id }}__radio" aria-hidden="true"></span>
        <span class="ai-offer-{{ ai_gen_id }}__details"><span class="ai-offer-{{ ai_gen_id }}__label">{{ label_value | escape }}</span><span class="ai-offer-{{ ai_gen_id }}__unit">{{ unit_value | escape }}</span></span>
        <span class="ai-offer-{{ ai_gen_id }}__price">{{ price_value | escape }}</span>
        {% if badge_value != blank %}<span class="ai-offer-{{ ai_gen_id }}__badge">{{ badge_value | escape }}</span>{% endif %}
      </button>
    {% endfor %}
  </div>
  <button type="button" class="ai-offer-{{ ai_gen_id }}__submit">{{ block.settings.button_label | escape }}</button>
  <p class="ai-offer-{{ ai_gen_id }}__error" role="alert" hidden></p>
</one-click-offer-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'one-click-offer-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class OneClickOffer extends HTMLElement {
      connectedCallback() {
        this.cards = Array.from(this.querySelectorAll('[role="radio"]'));
        this.submitButton = this.querySelector('button[type="button"].ai-offer-{{ ai_gen_id }}__submit');
        this.error = this.querySelector('[role="alert"]');
        this.cards.forEach((card) => card.addEventListener('click', () => this.select(card)));
        this.submitButton.addEventListener('click', () => this.checkout());
        this.cards.forEach((card, index) => card.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') { event.preventDefault(); this.cards[(index + 1) % this.cards.length].focus(); this.select(this.cards[(index + 1) % this.cards.length]); }
          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') { event.preventDefault(); this.cards[(index + this.cards.length - 1) % this.cards.length].focus(); this.select(this.cards[(index + this.cards.length - 1) % this.cards.length]); }
        }));
      }
      select(card) {
        this.cards.forEach((item) => item.setAttribute('aria-checked', item === card ? 'true' : 'false'));
      }
      async checkout() {
        const selected = this.cards.find((card) => card.getAttribute('aria-checked') === 'true');
        if (!selected || this.submitButton.disabled) return;
        this.submitButton.disabled = true;
        this.error.hidden = true;
        try {
          const response = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error();
          const cart = await response.json();
          const existing = cart.items.filter((item) => String(item.variant_id) === this.dataset.variantId).reduce((sum, item) => sum + item.quantity, 0);
          if (existing > 0) {
            const updates = {};
            cart.items.forEach((item) => { if (String(item.variant_id) === this.dataset.variantId) updates[item.key] = 0; });
            const updateResponse = await fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ updates }) });
            if (!updateResponse.ok) throw new Error();
          }
          const addResponse = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: Number(this.dataset.variantId), quantity: Number(selected.dataset.quantity) }] }) });
          if (!addResponse.ok) throw new Error();
          window.location.assign('/checkout');
        } catch (error) {
          this.error.textContent = this.dataset.error;
          this.error.hidden = false;
          this.submitButton.disabled = false;
        }
      }
    }
    customElements.define(tagName, OneClickOffer);
  })();
</script>

{% schema %}
{
  "name": "One-click offer selector",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your offer" },
    { "type": "header", "content": "Offer 1" },
    { "type": "text", "id": "offer_1_label", "label": "Label", "default": "1 Bottle" },
    { "type": "text", "id": "offer_1_price", "label": "Price", "default": "$16" },
    { "type": "text", "id": "offer_1_unit", "label": "Shipping or unit detail", "default": "Customer-paid shipping · Quantity 1" },
    { "type": "text", "id": "offer_1_badge", "label": "Badge", "default": "Standard shipping" },
    { "type": "header", "content": "Offer 2" },
    { "type": "text", "id": "offer_2_label", "label": "Label", "default": "2 Bottles" },
    { "type": "text", "id": "offer_2_price", "label": "Price", "default": "$32" },
    { "type": "text", "id": "offer_2_unit", "label": "Shipping or unit detail", "default": "Free shipping · Quantity 2" },
    { "type": "text", "id": "offer_2_badge", "label": "Badge", "default": "Most Popular" },
    { "type": "header", "content": "Offer 3" },
    { "type": "text", "id": "offer_3_label", "label": "Label", "default": "3 Bottles" },
    { "type": "text", "id": "offer_3_price", "label": "Price", "default": "$44" },
    { "type": "text", "id": "offer_3_unit", "label": "Shipping or unit detail", "default": "Free shipping · Quantity 3" },
    { "type": "text", "id": "offer_3_badge", "label": "Badge", "default": "Best Value" },
    { "type": "header", "content": "Checkout" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy now" },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "We couldn't prepare checkout. Please try again." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "One-click offer selector" }],
  "tag": null,
  "class": "one-click-offer-selector"
}
{% endschema %}