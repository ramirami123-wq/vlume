{% doc %}
  @prompt
    Create a copy of the currently selected Vlume offer selector directly on the Hair Removal Spray Foam product page, in the main purchase area near the product price and purchase controls. Match the current selector’s colors, typography, spacing, button style, badges, units, and one-click behavior. Use product variant ID 48167019741438. Preserve these offers: 1 Bottle for $16 with customer-paid shipping and quantity 1; 2 Bottles for $32 with free shipping and quantity 2, labeled Most Popular and highlighted by default; 3 Bottles for $44 with free shipping and quantity 3, labeled Best Value. A single click must add the exact quantity, prevent duplicate quantities from existing cart contents, and go directly to Shopify checkout while allowing the store’s automatic product and shipping discounts to apply. Do not display $43 anywhere. Keep the offer labels and prices editable. This is a product-page replacement for the existing homepage selector, not an additional homepage section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-vlume-offers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: #212326;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
    font-size: 15px;
  }
  .ai-vlume-offers-{{ ai_gen_id }}__heading { margin: 0 0 10px; font-weight: 600; }
  .ai-vlume-offers-{{ ai_gen_id }}__list { display: grid; gap: 9px; }
  .ai-vlume-offers-{{ ai_gen_id }}__option {
    position: relative; display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 12px;
    min-height: 72px; padding: 12px 16px; border: 1px solid #d2d5d9; border-radius: 10px;
    background: #fff; cursor: pointer; text-align: left; color: inherit; width: 100%; font: inherit;
  }
  .ai-vlume-offers-{{ ai_gen_id }}__option[aria-pressed="true"] { border: 2px solid #212326; background: #f7f8f7; }
  .ai-vlume-offers-{{ ai_gen_id }}__radio { width: 19px; height: 19px; border: 1.5px solid #555; border-radius: 50%; display: grid; place-items: center; }
  .ai-vlume-offers-{{ ai_gen_id }}__option[aria-pressed="true"] .ai-vlume-offers-{{ ai_gen_id }}__radio:after { content: ''; width: 9px; height: 9px; border-radius: 50%; background: #212326; }
  .ai-vlume-offers-{{ ai_gen_id }}__copy { display: flex; flex-direction: column; gap: 3px; }
  .ai-vlume-offers-{{ ai_gen_id }}__title { font-weight: 600; }
  .ai-vlume-offers-{{ ai_gen_id }}__detail { color: #414449; font-size: 13px; }
  .ai-vlume-offers-{{ ai_gen_id }}__price { font-family: {{ settings.type_header_font.family }}, sans-serif; font-weight: 700; white-space: nowrap; }
  .ai-vlume-offers-{{ ai_gen_id }}__badge { position: absolute; right: 12px; top: -9px; padding: 3px 9px; border-radius: 20px; background: #212326; color: #fff; font-size: 11px; font-weight: 600; }
  .ai-vlume-offers-{{ ai_gen_id }}__option--badged { padding-top: 16px; }
  .ai-vlume-offers-{{ ai_gen_id }}__submit { display: block; width: 100%; margin-top: 12px; padding: 15px 18px; border: 1px solid #212326; border-radius: 10px; background: #212326; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .ai-vlume-offers-{{ ai_gen_id }}__submit:hover { background: #34363a; }
  .ai-vlume-offers-{{ ai_gen_id }}__submit:focus-visible, .ai-vlume-offers-{{ ai_gen_id }}__option:focus-visible { outline: 3px solid #87adf5; outline-offset: 3px; }
  .ai-vlume-offers-{{ ai_gen_id }}__message { margin: 8px 0 0; color: #9b1c1c; font-size: 13px; }
  @media (max-width: 749px) { .ai-vlume-offers-{{ ai_gen_id }} { width: 100%; } }
{% endstyle %}

<vlume-offer-selector-{{ ai_gen_id }} class="ai-vlume-offers-{{ ai_gen_id }}" data-variant-id="48167019741438" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<p class="ai-vlume-offers-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</p>{% endif %}
  <div class="ai-vlume-offers-{{ ai_gen_id }}__list" role="group" aria-label="Choose a bottle offer">
    <button type="button" class="ai-vlume-offers-{{ ai_gen_id }}__option" data-quantity="1" aria-pressed="false">
      <span class="ai-vlume-offers-{{ ai_gen_id }}__radio" aria-hidden="true"></span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__copy"><span class="ai-vlume-offers-{{ ai_gen_id }}__title">{{ block.settings.offer_one | escape }}</span><span class="ai-vlume-offers-{{ ai_gen_id }}__detail">{{ block.settings.detail_one | escape }}</span></span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__price">{{ block.settings.price_one | escape }}</span>
    </button>
    <button type="button" class="ai-vlume-offers-{{ ai_gen_id }}__option ai-vlume-offers-{{ ai_gen_id }}__option--badged" data-quantity="2" aria-pressed="true">
      <span class="ai-vlume-offers-{{ ai_gen_id }}__badge">{{ block.settings.badge_two | escape }}</span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__radio" aria-hidden="true"></span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__copy"><span class="ai-vlume-offers-{{ ai_gen_id }}__title">{{ block.settings.offer_two | escape }}</span><span class="ai-vlume-offers-{{ ai_gen_id }}__detail">{{ block.settings.detail_two | escape }}</span></span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__price">{{ block.settings.price_two | escape }}</span>
    </button>
    <button type="button" class="ai-vlume-offers-{{ ai_gen_id }}__option ai-vlume-offers-{{ ai_gen_id }}__option--badged" data-quantity="3" aria-pressed="false">
      <span class="ai-vlume-offers-{{ ai_gen_id }}__badge">{{ block.settings.badge_three | escape }}</span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__radio" aria-hidden="true"></span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__copy"><span class="ai-vlume-offers-{{ ai_gen_id }}__title">{{ block.settings.offer_three | escape }}</span><span class="ai-vlume-offers-{{ ai_gen_id }}__detail">{{ block.settings.detail_three | escape }}</span></span>
      <span class="ai-vlume-offers-{{ ai_gen_id }}__price">{{ block.settings.price_three | escape }}</span>
    </button>
  </div>
  <button type="button" class="ai-vlume-offers-{{ ai_gen_id }}__submit">{{ block.settings.button_label | escape }}</button>
  <p class="ai-vlume-offers-{{ ai_gen_id }}__message" role="alert" hidden></p>
</vlume-offer-selector-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'vlume-offer-selector-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class VlumeOfferSelector extends HTMLElement {
      connectedCallback() {
        this.options = this.querySelectorAll('[data-quantity]');
        this.message = this.querySelector('[role="alert"]');
        this.selectedQuantity = 2;
        this.options.forEach((option) => option.addEventListener('click', () => {
          this.selectedQuantity = Number(option.dataset.quantity);
          this.options.forEach((item) => item.setAttribute('aria-pressed', item === option ? 'true' : 'false'));
          this.message.hidden = true;
        }));
        this.querySelector('.__submit')?.addEventListener('click', () => this.addSelected());
        const submit = this.querySelector('button[class*="__submit"]');
        if (submit) submit.addEventListener('click', () => this.addSelected());
      }
      async addSelected() {
        const submit = this.querySelector('button[class*="__submit"]');
        submit.disabled = true;
        this.message.hidden = true;
        try {
          const cartResponse = await fetch('/cart.js', { headers: { 'Accept': 'application/json' } });
          if (!cartResponse.ok) throw new Error('Could not read cart.');
          const cart = await cartResponse.json();
          const variantId = Number(this.dataset.variantId);
          const matching = cart.items.filter((item) => item.variant_id === variantId);
          if (matching.length) {
            const updates = {};
            matching.forEach((item) => { updates[item.key] = 0; });
            const updateResponse = await fetch('/cart/update.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ updates: updates }) });
            if (!updateResponse.ok) throw new Error('Could not update cart.');
          }
          const addResponse = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: variantId, quantity: this.selectedQuantity }] }) });
          if (!addResponse.ok) throw new Error('This offer is currently unavailable.');
          window.location.assign('/checkout');
        } catch (error) {
          this.message.textContent = error.message || 'Unable to add this offer. Please try again.';
          this.message.hidden = false;
          submit.disabled = false;
        }
      }
    }
    customElements.define(tagName, VlumeOfferSelector);
  })();
</script>

{% schema %}
{
  "name": "Vlume offer selector",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose your offer" },
    { "type": "header", "content": "Single bottle" },
    { "type": "text", "id": "offer_one", "label": "Offer label", "default": "1 Bottle" },
    { "type": "text", "id": "price_one", "label": "Price", "default": "$16" },
    { "type": "text", "id": "detail_one", "label": "Shipping and quantity", "default": "Shipping paid by customer · Quantity 1" },
    { "type": "header", "content": "Two bottles" },
    { "type": "text", "id": "offer_two", "label": "Offer label", "default": "2 Bottles" },
    { "type": "text", "id": "price_two", "label": "Price", "default": "$32" },
    { "type": "text", "id": "detail_two", "label": "Shipping and quantity", "default": "Free shipping · Quantity 2" },
    { "type": "text", "id": "badge_two", "label": "Badge", "default": "Most Popular" },
    { "type": "header", "content": "Three bottles" },
    { "type": "text", "id": "offer_three", "label": "Offer label", "default": "3 Bottles" },
    { "type": "text", "id": "price_three", "label": "Price", "default": "$44" },
    { "type": "text", "id": "detail_three", "label": "Shipping and quantity", "default": "Free shipping · Quantity 3" },
    { "type": "text", "id": "badge_three", "label": "Badge", "default": "Best Value" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Continue to checkout" }
  ],
  "presets": [{ "name": "Vlume offer selector" }],
  "tag": null,
  "class": "vlume-offer-selector-block"
}
{% endschema %}