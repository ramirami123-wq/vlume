{% doc %}
  @prompt
    Create a clean, mobile-friendly Before and After homepage section for Hair Removal Spray Foam. Include exactly two independent image upload options only: one Before image and one After image. Display each image in its own full-width row, with the Before image first and the After image underneath. Do not include an alternate-angle image, extra image slot, gallery, or comparison slider. Use a square 1:1 image ratio, prevent stretching, and keep important areas centered. Add clear editable “Before” and “After” labels, an editable heading, and a short “Individual results may vary” disclaimer. Make the layout responsive and visually consistent with the store. Do not add placeholder or fabricated result images.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-before-after-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-before-after-container-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.max_content_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-before-after-heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-before-after-images-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_gap }}px;
  }

  .ai-before-after-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
  }

  .ai-before-after-image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.image_background }};
  }

  .ai-before-after-image-container-{{ ai_gen_id }} img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ai-before-after-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.image_background }};
  }

  .ai-before-after-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-before-after-label-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.label_position_vertical }}px;
    left: {{ block.settings.label_position_horizontal }}px;
    background-color: {{ block.settings.label_background }};
    color: {{ block.settings.label_color }};
    padding: {{ block.settings.label_padding_vertical }}px {{ block.settings.label_padding_horizontal }}px;
    border-radius: {{ block.settings.label_border_radius }}px;
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    text-transform: {{ block.settings.label_text_transform }};
    z-index: 2;
  }

  .ai-before-after-disclaimer-{{ ai_gen_id }} {
    text-align: center;
    margin-top: {{ block.settings.disclaimer_spacing }}px;
    font-size: {{ block.settings.disclaimer_font_size }}px;
    color: {{ block.settings.disclaimer_color }};
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-before-after-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-before-after-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-before-after-container-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.mobile_horizontal_padding }}px;
    }
  }
{% endstyle %}

<before-after-{{ ai_gen_id }} class="ai-before-after-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-before-after-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-before-after-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-before-after-images-{{ ai_gen_id }}">
      <div class="ai-before-after-image-wrapper-{{ ai_gen_id }}">
        <div class="ai-before-after-image-container-{{ ai_gen_id }}">
          {% if block.settings.before_image %}
            <img
              src="{{ block.settings.before_image | image_url: width: 1200 }}"
              alt="{{ block.settings.before_image.alt | escape }}"
              loading="lazy"
              width="1200"
              height="1200"
            >
          {% else %}
            <div class="ai-before-after-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.before_label != blank %}
            <div class="ai-before-after-label-{{ ai_gen_id }}">
              {{ block.settings.before_label }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-before-after-image-wrapper-{{ ai_gen_id }}">
        <div class="ai-before-after-image-container-{{ ai_gen_id }}">
          {% if block.settings.after_image %}
            <img
              src="{{ block.settings.after_image | image_url: width: 1200 }}"
              alt="{{ block.settings.after_image.alt | escape }}"
              loading="lazy"
              width="1200"
              height="1200"
            >
          {% else %}
            <div class="ai-before-after-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.after_label != blank %}
            <div class="ai-before-after-label-{{ ai_gen_id }}">
              {{ block.settings.after_label }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    {% if block.settings.disclaimer != blank %}
      <div class="ai-before-after-disclaimer-{{ ai_gen_id }}">
        {{ block.settings.disclaimer }}
      </div>
    {% endif %}
  </div>
</before-after-{{ ai_gen_id }}>

<script>
  (function() {
    class BeforeAfter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }
    customElements.define('before-after-{{ ai_gen_id }}', BeforeAfter{{ ai_gen_id }});
  })();
</script>

